# Server Environment: 'production' | 'development' | 'test'
NODE_ENV=production

# Server Port (assigned by Render/Railway/Heroku/VPS or defaults to 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas replica set URI or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mi_udyojak?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mi_udyojak?retryWrites=true&w=majority

# Primary Frontend URL allowed by CORS (e.g. https://miudyojakhonarach.com or https://mi-udyojak.vercel.app)
FRONTEND_URL=https://miudyojakhonarach.com

# Additional Allowed Origins for CORS (comma-separated, optional)
# Example: https://www.miudyojakhonarach.com,https://me-udyojag-honarch.vercel.app
ALLOWED_ORIGINS=https://www.miudyojakhonarach.com,https://me-udyojag-honarch.vercel.app

# Notification Email Addresses
ADMIN_EMAIL=miudyojakhonarch@gmail.com
EMAIL_FROM="Mi Udyojak Honarach <miudyojakhonarch@gmail.com>"

# Administrator API Secret Key for accessing protected data endpoints (GET /api/enquiries, GET /api/event-registrations)
ADMIN_API_KEY=your_secure_admin_api_key_here

# SMTP Email Configuration (Nodemailer - Sends emails to both Admin and Submitter)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=miudyojakhonarch@gmail.com
SMTP_PASS=your_16_character_google_app_password
